# =====================================================
# APLICACIÓN
# =====================================================
APP_NAME=ficon-power-backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=1.0.0
TZ=America/Lima

# =====================================================
# BASE DE DATOS (SUPABASE POSTGRESQL)
# =====================================================
DB_HOST=db.xxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD
DB_SSLMODE=require

# Opcional. También se acepta jdbc:postgresql://...
DATABASE_URL=postgres://postgres:TU_PASSWORD@db.xxxxxxxxx.supabase.co:5432/postgres?sslmode=require

# =====================================================
# WHATSAPP CLOUD API
# WHATSAPP_API_URL debe ser el endpoint que recibe mensajes.
# =====================================================
WHATSAPP_API_URL=https://graph.facebook.com/v25.0/PHONE_NUMBER_ID/messages
WHATSAPP_PHONE=51999999999
WHATSAPP_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
# Configure el idioma exacto y el nombre de plantilla aprobada por evento.
# El backend solo envía plantillas Meta; si falta una plantilla, no usa texto libre.
# WHATSAPP_TEMPLATE_NAME funciona como fallback para ambos eventos si no se definen las plantillas específicas.
# El orden de *_TEMPLATE_PARAMS debe coincidir con las variables de Meta:
#   dispositivo = {{1}}, fechaCorte = {{2}}, fechaRetorno = {{3}}
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_OUTAGE_TEMPLATE_NAME=
WHATSAPP_OUTAGE_TEMPLATE_PARAMS=dispositivo,fechaCorte
WHATSAPP_RESTORED_TEMPLATE_NAME=
WHATSAPP_RESTORED_TEMPLATE_PARAMS=dispositivo,fechaCorte,fechaRetorno

# =====================================================
# FIREBASE CLOUD MESSAGING (PUSH MOBILE)
# =====================================================
# Permite que Android reciba alertas incluso si la app está cerrada.
# Use una cuenta de servicio Firebase/Google Cloud con permiso de FCM.
FCM_ENABLED=false
FCM_PROJECT_ID=
# Ruta dentro del contenedor. docker-compose.yml monta secrets/ en /app/secrets.
FCM_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
# Alternativa: JSON completo en variable de entorno. No comitear.
FCM_CREDENTIALS_JSON=
# true permite validar flujo sin enviar realmente.
FCM_DRY_RUN=false

# =====================================================
# ESCALAMIENTO DE ALERTAS DE CORTE
# =====================================================
# Repite alertas push de cortes activos hasta que el incidente sea revisado
# desde la app o quede resuelto por retorno de energia.
POWER_ALERT_ESCALATION_ENABLED=true
# Milisegundos entre revisiones de alertas vencidas.
POWER_ALERT_ESCALATION_POLL_DELAY=15000
POWER_ALERT_ESCALATION_BATCH_SIZE=50

# =====================================================
# TUYA
# =====================================================
# Consumidor Tuya Pulsar. Active Message Service en el proyecto de Tuya.
TUYA_PULSAR_ENABLED=false
TUYA_PULSAR_URL=pulsar+ssl://mqe.tuyaus.com:7285/
TUYA_ACCESS_ID=TU_ACCESS_ID
TUYA_ACCESS_KEY=TU_ACCESS_SECRET
# Valores permitidos: prod, test
TUYA_PULSAR_ENV=prod
# Opcional; por defecto usa {TUYA_ACCESS_ID}-sub
TUYA_PULSAR_SUBSCRIPTION=
# true: notifica directamente sin consultar ni escribir en la base de datos
TUYA_PULSAR_DIRECT_NOTIFICATIONS=false
# Mitigación temporal para endpoints que no entregan el intermedio RapidSSL.
TUYA_PULSAR_TLS_TRUST_CERTS_PATH=/app/certs/tuya-pulsar-ca-bundle.pem
TUYA_CLOUD_ENABLED=true
TUYA_API_URL=https://openapi-ueaz.tuyaus.com

# =====================================================
# SEGURIDAD DE LA API
# Las credenciales locales de ejemplo viven en .local/credentials.local.md.
# Esa ruta está ignorada por Git y no debe publicarse.
# API_KEY queda como acceso alterno para integraciones máquina-a-máquina.
# Si API_KEY está definida, también se acepta el header X-API-Key.
# =====================================================
API_KEY=
AUTH_ACCESS_DURATION=24h
AUTH_REFRESH_DURATION=90d

# Única cuenta creada al inicializar una base nueva. El correo se usa para iniciar sesión.
# No reutilice estas credenciales entre pruebas y producción.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CambiarPorUnaClaveSegura

# =====================================================
# CORS (reservado para la API móvil)
# =====================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# =====================================================
# LOGS Y DOCKER
# =====================================================
LOG_LEVEL=INFO
DOCKER_CONTAINER_NAME=ficon-power-backend
